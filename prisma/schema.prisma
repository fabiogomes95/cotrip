// CoTrip — schema do banco
// Multi-tenant com compartilhamento: viagens (Trip) pertencem a um quadro (Board),
// e cada quadro tem membros (BoardMember). Convites por email (Invitation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: endpoint com pooling (host termina em "-pooler"), para aguentar
  // o serverless da Vercel sem estourar o limite de conexoes do Postgres.
  url       = env("DATABASE_URL")
  // Migracoes: conexao direta (sem pooler) — o migrate precisa de sessao propria.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  BoardMember[]
  paidItems    ChecklistItem[]
  paidExpenses Expense[]
}

model Board {
  id          String        @id @default(cuid())
  name        String
  createdAt   DateTime      @default(now())
  members     BoardMember[]
  trips       Trip[]
  invitations Invitation[]
}

enum Role {
  OWNER
  EDITOR
}

model BoardMember {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

enum TripStatus {
  IDEIA
  PLANEJANDO
  RESERVADO
  FEITA
}

model Trip {
  id          String     @id @default(cuid())
  board       Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String
  dest        String
  whenText    String     @default("") // época em texto livre: "Julho", "Carnaval"...
  year        Int        @default(0) // 0 = "algum dia" (sem data definida)
  // Datas exatas, quando já se sabe. @db.Date guarda só a data, sem hora e
  // sem fuso: uma viagem que começa dia 12 começa dia 12 em qualquer lugar do
  // mundo. Com DateTime completo, quem abrisse o app em outro fuso veria 11.
  startDate   DateTime?  @db.Date
  endDate     DateTime?  @db.Date
  status      TripStatus @default(IDEIA)
  // Dinheiro é guardado em CENTAVOS, sempre. O nome do campo carrega a
  // unidade de propósito: "budget" guardando centavos seria uma armadilha
  // silenciosa para quem lesse o código depois.
  budgetCents Int? // orçamento estimado por pessoa, em centavos
  // Quantas pessoas vão. Valores (budget e itens do checklist) continuam
  // sendo POR PESSOA; isto serve para o app mostrar também o total.
  people      Int        @default(1)
  note        String     @default("")

  /**
   * Hospedagem. Um lugar por viagem: e o caso comum, e "a casa do primo em
   * Jampa" e exatamente o que se quer achar no mapa depois. Viagem com duas
   * bases (Lisboa e Porto) pediria um modelo proprio — quando isso doer,
   * vira tabela.
   */
  stayName    String @default("") // "Casa do Junete", "Pousada do Vale"
  stayAddress String @default("")
  /// Float e nao Decimal: coordenada nao e dinheiro. A precisao de um double
  /// passa de centimetros, muito alem do que um pino de mapa precisa.
  stayLat     Float?
  stayLng     Float?

  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  items      ChecklistItem[]
  preTasks   PreTripTask[]
  activities Activity[]
  expenses   Expense[]

  @@index([boardId])
}

// Itens do checklist de uma viagem: "Passagem", "Hospedagem"...
// O budget da Trip e a ESTIMATIVA; a soma dos amounts daqui e o REAL gasto.
model ChecklistItem {
  id          String  @id @default(cuid())
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  label       String
  done        Boolean @default(false)
  amountCents Int? // valor total do item por pessoa, em centavos; null = nao se sabe

  /**
   * Pagamento.
   * `done` continua significando CONTRATADO (resolvido, reservado), que e
   * coisa diferente de PAGO: passagem parcelada em 6x esta contratada no dia
   * um e paga so no sexto mes. Guardar as duas coisas separadas e o que
   * permite responder "quanto ainda vai sair do bolso".
   * Modelei como tres escalares em vez de uma tabela de parcelas porque tudo
   * que o app precisa e derivavel deles: valor da parcela, total pago, o que
   * falta e o proximo vencimento. Uma tabela so se pagaria se cada parcela
   * tivesse valor ou data propria.
   */
  /**
   * /**
   * /**
   * /**
   * /* Entrada: o pedaco pago na hora da compra. O que sobra (amountCents menos
   * a entrada) e que se divide em `installments`. Fica separado do valor das
   * parcelas porque entrada quase nunca e igual a uma parcela — e porque so
   * assim da para dizer "dei 500 e parcelei o resto em 6".
   */
  downPaymentCents Int? // valor da entrada, em centavos; null = sem entrada
  downPaymentPaid  Boolean @default(false)

  installments     Int       @default(1) // em quantas vezes vai o RESTANTE
  paidInstallments Int       @default(0) // quantas dessas ja foram pagas
  firstDueDate     DateTime? @db.Date // vencimento da primeira parcela

  /**
   * Quem bancou este item, em quadro compartilhado. onDelete: SetNull porque
   * a despesa continua existindo se a pessoa sair do quadro — some só o
   * crédito dela, e o item nao pode sumir junto.
   */
  paidBy    User?    @relation(fields: [paidById], references: [id], onDelete: SetNull)
  paidById  String?
  position  Int      @default(0) // ordem de exibicao, definida pelo usuario
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([paidById])
}

// Uma tentativa registrada para limite de taxa (ver src/lib/rate-limit.ts).
// Fica no banco, e não em memória, porque na Vercel cada requisição pode cair
// numa instância diferente — um contador em memória zeraria a cada uma.
model RateHit {
  id        String   @id @default(cuid())
  key       String // "escopo:hash-do-ip" — o IP em si não é guardado
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Quando a tarefa precisa ser feita. Agrupa a lista em vez de virar data:
/// "na véspera" é mais útil que "11/11", e não quebra se a viagem mudar de dia.
enum PreTripWhen {
  ANTES // nas semanas anteriores
  VESPERA // na véspera
  SAIDA // na hora de sair de casa
}

/// Tarefa de antes de viajar: desligar o gás, quem alimenta os gatos,
/// deixar chave com alguém.
///
/// Modelo separado do ChecklistItem de propósito. Aquele existe para
/// dinheiro (valor, parcelas, quem pagou); aqui nada disso faz sentido, e
/// os sete campos financeiros ficariam nulos em toda linha. O que esta
/// lista precisa — responsável e momento — o outro não tem.
model PreTripTask {
  id     String @id @default(cuid())
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String

  label String
  done  Boolean @default(false)

  /// Quem ficou de fazer. Texto livre, e nao uma relacao com User, porque
  /// quem alimenta o gato costuma ser a vizinha ou o irmao — gente que nao
  /// tem conta no app e nunca vai ter.
  assignee String      @default("")
  when     PreTripWhen @default(ANTES)
  position Int         @default(0)

  createdAt DateTime @default(now())

  @@index([tripId])
}

enum ActivityStatus {
  IDEIA
  AGENDADO
  FEITO
}

/// Um passeio ou atividade no destino.
///
/// O que esta tabela guarda de mais valioso e o CONTATO: o telefone do
/// barqueiro, o nome de quem aluga o quadriciclo. Nao tem campo de dinheiro
/// de proposito — ver a nota em Expense sobre onde o dinheiro mora.
model Activity {
  id     String @id @default(cuid())
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String

  label   String
  /// Nome e telefone de quem organiza, em texto livre: e o que a pessoa
  /// copia de um WhatsApp e cola aqui.
  contact String @default("")

  whenAt   DateTime?      @db.Date
  /// Horario em texto: "9h", "de manha", "no fim da tarde". Raramente se
  /// sabe a hora exata de um passeio de barco, e "de manha" e informacao
  /// suficiente — uma coluna de hora obrigaria a inventar precisao.
  timeText String         @default("")
  status   ActivityStatus @default(IDEIA)
  note     String         @default("")
  position Int            @default(0)

  createdAt DateTime @default(now())

  @@index([tripId])
}

enum ExpenseCategory {
  TRANSPORTE
  ALIMENTACAO
  PASSEIO
  COMPRAS
  OUTROS
}

/// Um gasto avulso feito durante a viagem.
///
/// Dinheiro no app mora em dois lugares, com papeis distintos:
///
///   ChecklistItem — o que se PLANEJA e paga antes (passagem, hospedagem),
///                   em valores POR PESSOA
///   Expense       — o que se gasta NO destino, no dia a dia (Uber, comida),
///                   em valores TOTAIS
///
/// A divisao segue como a pessoa pensa: antes da viagem x durante. E a
/// unidade difere porque cada um e registrado de um jeito: orcamento se
/// pensa por cabeca, recibo de Uber vem com o valor cheio.
model Expense {
  id     String @id @default(cuid())
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId String

  label      String
  category   ExpenseCategory @default(OUTROS)
  /// TOTAL que saiu da carteira, em centavos — nao por pessoa. Um Uber de
  /// R$ 40 dividido entre duas pessoas e 4000 aqui.
  totalCents Int
  spentOn    DateTime?       @db.Date

  /// Quem bancou, para o acerto de contas.
  paidBy   User?   @relation(fields: [paidById], references: [id], onDelete: SetNull)
  paidById String?

  note String @default("")

  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([paidById])
}

model Invitation {
  id         String    @id @default(cuid())
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId    String
  email      String
  role       Role      @default(EDITOR)
  token      String    @unique @default(cuid())
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([email])
  @@index([boardId])
}
