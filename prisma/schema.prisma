// CoTrip — schema do banco
// Multi-tenant com compartilhamento: viagens (Trip) pertencem a um quadro (Board),
// e cada quadro tem membros (BoardMember). Convites por email (Invitation).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: endpoint com pooling (host termina em "-pooler"), para aguentar
  // o serverless da Vercel sem estourar o limite de conexoes do Postgres.
  url       = env("DATABASE_URL")
  // Migracoes: conexao direta (sem pooler) — o migrate precisa de sessao propria.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  BoardMember[]
  paidItems    ChecklistItem[]
}

model Board {
  id          String        @id @default(cuid())
  name        String
  createdAt   DateTime      @default(now())
  members     BoardMember[]
  trips       Trip[]
  invitations Invitation[]
}

enum Role {
  OWNER
  EDITOR
}

model BoardMember {
  id        String   @id @default(cuid())
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role     @default(EDITOR)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

enum TripStatus {
  IDEIA
  PLANEJANDO
  RESERVADO
  FEITA
}

model Trip {
  id          String          @id @default(cuid())
  board       Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId     String
  dest        String
  whenText    String          @default("") // época em texto livre: "Julho", "Carnaval"...
  year        Int             @default(0) // 0 = "algum dia" (sem data definida)
  // Datas exatas, quando já se sabe. @db.Date guarda só a data, sem hora e
  // sem fuso: uma viagem que começa dia 12 começa dia 12 em qualquer lugar do
  // mundo. Com DateTime completo, quem abrisse o app em outro fuso veria 11.
  startDate   DateTime?       @db.Date
  endDate     DateTime?       @db.Date
  status      TripStatus      @default(IDEIA)
  // Dinheiro é guardado em CENTAVOS, sempre. O nome do campo carrega a
  // unidade de propósito: "budget" guardando centavos seria uma armadilha
  // silenciosa para quem lesse o código depois.
  budgetCents Int? // orçamento estimado por pessoa, em centavos
  // Quantas pessoas vão. Valores (budget e itens do checklist) continuam
  // sendo POR PESSOA; isto serve para o app mostrar também o total.
  people      Int             @default(1)
  note        String          @default("")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       ChecklistItem[]

  @@index([boardId])
}

// Itens do checklist de uma viagem: "Passagem", "Hospedagem"...
// O budget da Trip e a ESTIMATIVA; a soma dos amounts daqui e o REAL gasto.
model ChecklistItem {
  id          String  @id @default(cuid())
  trip        Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripId      String
  label       String
  done        Boolean @default(false)
  amountCents Int? // valor total do item por pessoa, em centavos; null = nao se sabe

  /**
   * Pagamento.
   * `done` continua significando CONTRATADO (resolvido, reservado), que e
   * coisa diferente de PAGO: passagem parcelada em 6x esta contratada no dia
   * um e paga so no sexto mes. Guardar as duas coisas separadas e o que
   * permite responder "quanto ainda vai sair do bolso".
   * Modelei como tres escalares em vez de uma tabela de parcelas porque tudo
   * que o app precisa e derivavel deles: valor da parcela, total pago, o que
   * falta e o proximo vencimento. Uma tabela so se pagaria se cada parcela
   * tivesse valor ou data propria.
   */
  installments     Int       @default(1) // em quantas vezes
  paidInstallments Int       @default(0) // quantas ja foram pagas
  firstDueDate     DateTime? @db.Date // vencimento da primeira parcela

  /**
   * Quem bancou este item, em quadro compartilhado. onDelete: SetNull porque
   * a despesa continua existindo se a pessoa sair do quadro — some só o
   * crédito dela, e o item nao pode sumir junto.
   */
  paidBy    User?    @relation(fields: [paidById], references: [id], onDelete: SetNull)
  paidById  String?
  position  Int      @default(0) // ordem de exibicao, definida pelo usuario
  createdAt DateTime @default(now())

  @@index([tripId])
  @@index([paidById])
}

// Uma tentativa registrada para limite de taxa (ver src/lib/rate-limit.ts).
// Fica no banco, e não em memória, porque na Vercel cada requisição pode cair
// numa instância diferente — um contador em memória zeraria a cada uma.
model RateHit {
  id        String   @id @default(cuid())
  key       String // "escopo:hash-do-ip" — o IP em si não é guardado
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

model Invitation {
  id         String    @id @default(cuid())
  board      Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId    String
  email      String
  role       Role      @default(EDITOR)
  token      String    @unique @default(cuid())
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?

  @@index([email])
  @@index([boardId])
}
