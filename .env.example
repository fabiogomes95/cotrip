# --- Banco de dados (PostgreSQL) ---
# Local (via docker-compose): postgresql://cotrip:cotrip@localhost:5432/cotrip
# Produção: use um Postgres gerenciado (Neon, Supabase, Railway...) e cole a URL aqui.
DATABASE_URL="postgresql://cotrip:cotrip@localhost:5432/cotrip"

# --- Auth.js (NextAuth v5) ---
# Gere um segredo com:  openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# URL pública da aplicação (em produção, o domínio do deploy)
# Em dev pode deixar http://localhost:3000
AUTH_URL="http://localhost:3000"
