# ============================================================
#  Banco de dados (PostgreSQL)
# ------------------------------------------------------------
#  DATABASE_URL — usada pelo app em runtime.
#  DIRECT_URL   — usada pelas migracoes (prisma migrate).
#
#  No Neon as duas sao diferentes: a pooled (host com "-pooler")
#  aguenta o serverless da Vercel; a direta e necessaria porque o
#  migrate precisa de uma sessao propria, que o pooler nao da.
#
#  Neon:
#    DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.REGIAO.aws.neon.tech/cotrip?sslmode=require"
#    DIRECT_URL="postgresql://USER:PASS@ep-xxxx.REGIAO.aws.neon.tech/cotrip?sslmode=require"
#
#  Postgres local (docker compose) — sem pooler, as duas sao iguais:
DATABASE_URL="postgresql://cotrip:cotrip@localhost:5432/cotrip"
DIRECT_URL="postgresql://cotrip:cotrip@localhost:5432/cotrip"
# ============================================================

# --- Auth.js (NextAuth v5) ---
# Gere um segredo com:  openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio"

# URL publica da aplicacao. Em dev, http://localhost:3000.
# Na Vercel pode omitir: o Auth.js v5 detecta o dominio sozinho.
AUTH_URL="http://localhost:3000"
